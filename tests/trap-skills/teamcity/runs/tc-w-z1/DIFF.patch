--- /dev/null
+++ b/.teamcity/settings.kts
@@ -0,0 +1,15 @@
+import jetbrains.buildServer.configs.kotlin.*
+
+version = "2024.12"
+
+// Depot - образец; остальным сервисам с той же схемой достаточно подключить DotnetService.kt и задать свой ServiceSpec.
+project(
+    DotnetService(
+        ServiceSpec(
+            name = "Depot",
+            slnOrProject = "Depot.sln",
+            vcsUrl = "https://git.example.com/depot/depot.git", // TODO: реальный URL репозитория
+            imageName = "depot/depot-api",
+        )
+    )
+)
