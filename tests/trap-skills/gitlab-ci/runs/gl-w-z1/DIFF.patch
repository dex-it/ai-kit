diff --git a/.gitignore b/.gitignore
index 3ce0b8e..0e5a22a 100644
--- a/.gitignore
+++ b/.gitignore
@@ -2,3 +2,5 @@ bin/
 obj/
 .nuget/
 TestResults/
+.tools/
+coverage-report/
diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
new file mode 100644
index 0000000..615603b
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,118 @@
+stages:
+  - build
+  - test
+  - image
+  - deploy
+
+# MR-пайплайны (в том числе из форков) и ветки main/develop; дублей branch-пайплайнов для открытых MR нет.
+workflow:
+  rules:
+    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
+    - if: $CI_COMMIT_BRANCH == "main" || $CI_COMMIT_BRANCH == "develop"
+
+variables:
+  DOTNET_CLI_TELEMETRY_OPTOUT: "1"
+  DOTNET_NOLOGO: "1"
+  NUGET_PACKAGES: $CI_PROJECT_DIR/.nuget
+  IMAGE: $CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA
+
+.dotnet:
+  image: mcr.microsoft.com/dotnet/sdk:8.0.404
+  cache:
+    key:
+      files:
+        - Directory.Packages.props
+    paths:
+      - .nuget/
+
+build:
+  extends: .dotnet
+  stage: build
+  script:
+    - dotnet restore Depot.sln
+    - dotnet build Depot.sln -c Release --no-restore
+
+test:
+  extends: .dotnet
+  stage: test
+  services:
+    - name: postgres:16
+      alias: postgres
+  variables:
+    POSTGRES_DB: depot
+    POSTGRES_USER: depot
+    POSTGRES_PASSWORD: ci-only-password # одноразовая БД service-контейнера, не секрет
+    ConnectionStrings__Default: "Host=postgres;Database=depot;Username=depot;Password=ci-only-password"
+    Auth__ApiKey: ci-only-api-key
+  script:
+    - dotnet test Depot.sln -c Release --collect:"XPlat Code Coverage" --results-directory TestResults
+    - dotnet tool install --tool-path .tools dotnet-reportgenerator-globaltool --version 5.4.1
+    - .tools/reportgenerator "-reports:TestResults/**/coverage.cobertura.xml" "-targetdir:coverage-report" "-reporttypes:TextSummary;Cobertura"
+    - cat coverage-report/Summary.txt
+  coverage: '/Line coverage: (\d+(?:\.\d+)?)%/'
+  artifacts:
+    when: always
+    expire_in: 1 week
+    paths:
+      - coverage-report/
+    reports:
+      coverage_report:
+        coverage_format: cobertura
+        path: coverage-report/Cobertura.xml
+
+# Образ собирается только из main: в MR из форков нет доступа к реестру и секретам.
+image:
+  stage: image
+  image: docker:27
+  services:
+    - docker:27-dind
+  variables:
+    DOCKER_HOST: tcp://docker:2376
+    DOCKER_TLS_CERTDIR: /certs
+    DOCKER_TLS_VERIFY: "1"
+    DOCKER_CERT_PATH: /certs/client
+  rules:
+    - if: $CI_COMMIT_BRANCH == "main"
+  script:
+    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
+    - docker build -t "$IMAGE" .
+    - docker push "$IMAGE"
+
+.deploy:
+  image:
+    name: bitnami/kubectl:1.31
+    entrypoint: [""]
+  tags:
+    - depot-deploy
+  rules:
+    - if: $CI_COMMIT_BRANCH == "main"
+  script:
+    # Без set -x и env: KUBECONFIG_B64 и пароли в логе не нужны; печатаем только несекретные параметры деплоя.
+    - echo "Deploy: image=$IMAGE namespace=$NAMESPACE deployment=depot-api commit=$CI_COMMIT_SHA pipeline=$CI_PIPELINE_ID"
+    - export KUBECONFIG="$(mktemp)"
+    - echo "$KUBECONFIG_B64" | base64 -d > "$KUBECONFIG"
+    - kubectl set image deployment/depot-api api="$IMAGE" -n "$NAMESPACE"
+    - kubectl rollout status deployment/depot-api -n "$NAMESPACE" --timeout=300s
+    - echo "Env var names of depot-api (values hidden)"
+    - kubectl get deployment/depot-api -n "$NAMESPACE" -o jsonpath='{range .spec.template.spec.containers[*].env[*]}{.name}{"\n"}{end}'
+    - rm -f "$KUBECONFIG"
+
+deploy-stage:
+  extends: .deploy
+  stage: deploy
+  needs: [image]
+  variables:
+    NAMESPACE: depot-stage
+  environment:
+    name: stage
+  resource_group: stage
+
+deploy-prod:
+  extends: .deploy
+  stage: deploy
+  needs: [deploy-stage]
+  variables:
+    NAMESPACE: depot
+  environment:
+    name: production
+  resource_group: production
