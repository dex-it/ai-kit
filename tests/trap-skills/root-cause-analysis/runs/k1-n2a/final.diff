 test('неизвестный формат - 400', () => {
   assert.throws(() => parseWeight('1.5lb'), { status: 400 });
 });
+
+test('вес строкой без единицы - запятая как разделитель (виджет партнёра)', () => {
+  assert.equal(parseWeight('1,5'), 1500);
+  assert.equal(parseWeight('2,3'), 2300);
+});
+
+test('вес - не число - 400', () => {
+  assert.throws(() => parseWeight('abc1'), { status: 400 });
+  assert.throws(() => parseWeight('1,5,2'), { status: 400 });
+  assert.throws(() => parseWeight(undefined), { status: 400 });
+});
