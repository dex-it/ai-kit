diff --git a/web/src/components/__tests__/OrdersPage.test.tsx b/web/src/components/__tests__/OrdersPage.test.tsx
index c74b0b5..e7b8a57 100644
--- a/web/src/components/__tests__/OrdersPage.test.tsx
+++ b/web/src/components/__tests__/OrdersPage.test.tsx
@@ -1,4 +1,5 @@
-import { render, screen } from '@testing-library/react';
+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
 import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
 import type { Order } from '../../types';
 import { OrdersPage } from '../OrdersPage';
@@ -58,4 +59,53 @@ describe('OrdersPage', () => {
 
     expect(await screen.findByText('Не удалось загрузить заказы')).toBeInTheDocument();
   });
+
+  it('searches orders by query as the user types', async () => {
+    const fetchMock = vi.fn(async (input: RequestInfo | URL) => {
+      const q = new URL(String(input), 'http://localhost').searchParams.get('q');
+      return jsonResponse(q ? orders.filter((order) => order.items[0].title.toLowerCase().includes(q)) : orders);
+    });
+    vi.stubGlobal('fetch', fetchMock);
+
+    render(<OrdersPage />);
+    expect(await screen.findByText('Заказ #1002')).toBeInTheDocument();
+
+    await userEvent.type(screen.getByLabelText('Поиск заказов'), 'улун');
+
+    await waitFor(() => expect(screen.queryByText('Заказ #1003')).not.toBeInTheDocument());
+    expect(screen.getByText('Заказ #1002')).toBeInTheDocument();
+    expect(fetchMock).toHaveBeenLastCalledWith(`/api/orders?q=${encodeURIComponent('улун')}`, expect.anything());
+  });
+
+  it('shows a message when nothing matches the query', async () => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => jsonResponse([])),
+    );
+
+    render(<OrdersPage />);
+    await userEvent.type(screen.getByLabelText('Поиск заказов'), 'zzz');
+
+    expect(await screen.findByText('Ничего не найдено')).toBeInTheDocument();
+    expect(screen.queryByText('У вас пока нет заказов')).not.toBeInTheDocument();
+  });
+
+  it('restores the full list when the query is cleared', async () => {
+    const fetchMock = vi.fn(async (input: RequestInfo | URL) => {
+      const q = new URL(String(input), 'http://localhost').searchParams.get('q');
+      return jsonResponse(q ? [] : orders);
+    });
+    vi.stubGlobal('fetch', fetchMock);
+
+    render(<OrdersPage />);
+    const field = screen.getByLabelText('Поиск заказов');
+    await userEvent.type(field, 'zzz');
+    expect(await screen.findByText('Ничего не найдено')).toBeInTheDocument();
+
+    await userEvent.clear(field);
+
+    expect(await screen.findByText('Заказ #1002')).toBeInTheDocument();
+    expect(screen.getByText('Заказ #1003')).toBeInTheDocument();
+    expect(fetchMock).toHaveBeenLastCalledWith('/api/orders', expect.anything());
+  });
 });
