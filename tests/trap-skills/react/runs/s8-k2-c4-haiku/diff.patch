--- a/web/src/components/__tests__/OrdersPage.test.tsx
+++ b/web/src/components/__tests__/OrdersPage.test.tsx
@@ -1,4 +1,5 @@
 import { render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
 import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
 import type { Order } from '../../types';
 import { OrdersPage } from '../OrdersPage';
@@ -58,4 +59,39 @@ describe('OrdersPage', () => {
 
     expect(await screen.findByText('Не удалось загрузить заказы')).toBeInTheDocument();
   });
+
+  it('searches orders on the server as the user types', async () => {
+    const fetchMock = vi.fn(async (input: string) => {
+      const q = new URL(input, 'http://localhost').searchParams.get('q') ?? '';
+      return jsonResponse(orders.filter((order) => order.items.some((item) => item.title.toLowerCase().includes(q))));
+    });
+    vi.stubGlobal('fetch', fetchMock);
+
+    render(<OrdersPage />);
+    expect(await screen.findByText('Заказ #1002')).toBeInTheDocument();
+
+    await userEvent.type(screen.getByLabelText('Поиск заказов'), 'чайник');
+
+    expect(fetchMock).toHaveBeenLastCalledWith('/api/orders?q=%D1%87%D0%B0%D0%B9%D0%BD%D0%B8%D0%BA', expect.anything());
+    expect(await screen.findByText('Заказ #1003')).toBeInTheDocument();
+    expect(screen.queryByText('Заказ #1002')).not.toBeInTheDocument();
+  });
+
+  it('shows the full list again when the query is cleared', async () => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async (input: string) => (input === '/api/orders' ? jsonResponse(orders) : jsonResponse([]))),
+    );
+
+    render(<OrdersPage />);
+    const search = screen.getByLabelText('Поиск заказов');
+    await userEvent.type(search, 'zzz');
+    expect(await screen.findByText('Ничего не найдено')).toBeInTheDocument();
+
+    await userEvent.clear(search);
+
+    expect(await screen.findByText('Заказ #1002')).toBeInTheDocument();
+    expect(screen.getByText('Заказ #1003')).toBeInTheDocument();
+    expect(screen.queryByText('Ничего не найдено')).not.toBeInTheDocument();
+  });
 });
