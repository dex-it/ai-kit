--- /dev/null
+++ b/api/test/pay.test.ts
@@ -0,0 +1,107 @@
+import request from 'supertest';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { createApp } from '../src/app.js';
+import { OrderStatus } from '../src/domain/order.js';
+import { HttpPaymentGateway } from '../src/payments/http-gateway.js';
+import type { PaymentGateway } from '../src/payments/gateway.js';
+import { demoUsers, seedDemo } from '../src/seed.js';
+import { Store } from '../src/store.js';
+
+function setup(charge: PaymentGateway['charge']) {
+  const store = new Store();
+  seedDemo(store);
+  const notifier = { orderPaid: vi.fn(async () => {}) };
+  const analytics = { track: vi.fn(async () => {}) };
+  const app = createApp({ store, payments: { charge: vi.fn(charge) }, notifier, analytics });
+  return { store, app, notifier, analytics };
+}
+
+async function loginAlice(app: ReturnType<typeof setup>['app']) {
+  const { email, password } = demoUsers.alice;
+  const res = await request(app).post('/api/login').send({ email, password }).expect(200);
+  return `Bearer ${res.body.token}`;
+}
+
+const approve: PaymentGateway['charge'] = async () => ({ status: 'approved', transactionId: 'tx_1' });
+
+describe('POST /api/orders/:id/pay', () => {
+  it('pays a new order', async () => {
+    const ctx = setup(approve);
+    const auth = await loginAlice(ctx.app);
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ id: 'ord-1001', status: 'paid', transactionId: 'tx_1' });
+    expect(ctx.store.getOrder('ord-1001')?.status).toBe(OrderStatus.Paid);
+    expect(ctx.notifier.orderPaid).toHaveBeenCalledOnce();
+    expect(ctx.analytics.track).toHaveBeenCalledWith('order_paid', {
+      orderNumber: 1001,
+      amountKopecks: ctx.store.getOrder('ord-1001')?.totalKopecks,
+    });
+  });
+
+  it('answers 402 and keeps the status when the bank declines', async () => {
+    const ctx = setup(async () => ({ status: 'declined', reason: 'insufficient_funds' }));
+    const auth = await loginAlice(ctx.app);
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(402);
+    expect(res.body).toEqual({ error: { code: 'payment_declined', message: 'insufficient_funds' } });
+    expect(ctx.store.getOrder('ord-1001')?.status).toBe(OrderStatus.New);
+    expect(ctx.notifier.orderPaid).not.toHaveBeenCalled();
+  });
+
+  it('answers 404 for foreign and missing orders', async () => {
+    const ctx = setup(approve);
+    const auth = await loginAlice(ctx.app);
+    await request(ctx.app).post('/api/orders/ord-1004/pay').set('Authorization', auth).expect(404);
+    await request(ctx.app).post('/api/orders/nope/pay').set('Authorization', auth).expect(404);
+  });
+
+  it('answers 409 for an already paid order', async () => {
+    const ctx = setup(approve);
+    const auth = await loginAlice(ctx.app);
+    await request(ctx.app).post('/api/orders/ord-1003/pay').set('Authorization', auth).expect(409);
+    await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+    await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(409);
+  });
+
+  it('does not fail the response when the notifier is down', async () => {
+    const ctx = setup(approve);
+    ctx.notifier.orderPaid.mockRejectedValue(new Error('down'));
+    const auth = await loginAlice(ctx.app);
+    await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+  });
+});
+
+describe('HttpPaymentGateway', () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    vi.useRealTimers();
+  });
+
+  const req = { orderId: 'ord-1', amountKopecks: 100, currency: 'RUB' } as const;
+
+  it('retries a network failure with the same order_id', async () => {
+    vi.useFakeTimers();
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('fetch failed'))
+      .mockResolvedValueOnce(Response.json({ status: 'approved', transaction_id: 'tx_9' }));
+    vi.stubGlobal('fetch', fetchMock);
+    const promise = new HttpPaymentGateway('http://pay.test', 'key').charge(req);
+    await vi.runAllTimersAsync();
+    await expect(promise).resolves.toEqual({ status: 'approved', transactionId: 'tx_9' });
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+    for (const call of fetchMock.mock.calls) {
+      expect(JSON.parse(call[1].body).order_id).toBe('ord-1');
+      expect(call[1].headers['X-Api-Key']).toBe('key');
+    }
+  });
+
+  it('maps a decline', async () => {
+    vi.stubGlobal('fetch', vi.fn(async () => Response.json({ status: 'declined', decline_reason: 'card_expired' })));
+    await expect(new HttpPaymentGateway('http://pay.test', 'key').charge(req)).resolves.toEqual({
+      status: 'declined',
+      reason: 'card_expired',
+    });
+  });
+});
