@@ -0,0 +1,75 @@
+import { logger } from '../logger.js';
+import type { ChargeRequest, ChargeResult, PaymentGateway } from './gateway.js';
+
+const MAX_ATTEMPTS = 3;
+const RETRY_DELAYS_MS = [500, 1500];
+const REQUEST_TIMEOUT_MS = 10_000;
+
+export class PaymentUnavailableError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'PaymentUnavailableError';
+  }
+}
+
+class TemporaryGatewayError extends Error {}
+
+function pause(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export class HttpPaymentGateway implements PaymentGateway {
+  constructor(
+    private readonly baseUrl: string,
+    private readonly apiKey: string,
+  ) {}
+
+  // Шлюз идемпотентен по order_id (сутки), поэтому при сетевом сбое, 409 и 5xx
+  // безопасно повторять запрос: двойного списания не будет.
+  async charge(req: ChargeRequest): Promise<ChargeResult> {
+    for (let attempt = 1; ; attempt += 1) {
+      try {
+        return await this.chargeOnce(req);
+      } catch (err) {
+        if (!(err instanceof TemporaryGatewayError)) throw err;
+        logger.warn(`payment gateway: ${err.message} for order ${req.orderId} (attempt ${attempt} of ${MAX_ATTEMPTS})`);
+        if (attempt >= MAX_ATTEMPTS) {
+          throw new PaymentUnavailableError('payment gateway is unavailable', { cause: err });
+        }
+        await pause(RETRY_DELAYS_MS[attempt - 1]);
+      }
+    }
+  }
+
+  private async chargeOnce(req: ChargeRequest): Promise<ChargeResult> {
+    let res: Response;
+    try {
+      res = await fetch(new URL('/v1/charges', this.baseUrl), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-Api-Key': this.apiKey },
+        body: JSON.stringify({ order_id: req.orderId, amount: req.amountKopecks, currency: req.currency }),
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+      });
+    } catch (err) {
+      throw new TemporaryGatewayError('network failure', { cause: err });
+    }
+    if (res.status === 409 || res.status >= 500) {
+      throw new TemporaryGatewayError(`gateway responded with ${res.status}`);
+    }
+    if (!res.ok) {
+      throw new PaymentUnavailableError(`payment gateway rejected the request with ${res.status}`);
+    }
+    const body = (await res.json()) as {
+      status?: string;
+      transaction_id?: string;
+      decline_reason?: string;
+    };
+    if (body.status === 'approved' && body.transaction_id) {
+      return { status: 'approved', transactionId: body.transaction_id };
+    }
+    if (body.status === 'declined') {
+      return { status: 'declined', reason: body.decline_reason ?? 'unknown' };
+    }
+    throw new PaymentUnavailableError('payment gateway returned an unexpected response');
+  }
+}
