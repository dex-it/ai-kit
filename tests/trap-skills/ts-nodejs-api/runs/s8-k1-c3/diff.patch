diff --git a/api/test/http-gateway.test.ts b/api/test/http-gateway.test.ts
new file mode 100644
index 0000000..95a4782
--- /dev/null
+++ b/api/test/http-gateway.test.ts
@@ -0,0 +1,49 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { HttpPaymentGateway, PaymentUnavailableError } from '../src/payments/http-gateway.js';
+
+const req = { orderId: 'ord-1', amountKopecks: 1000, currency: 'RUB' as const };
+const json = (status: number, body: unknown) => new Response(JSON.stringify(body), { status });
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('HttpPaymentGateway', () => {
+  it('sends the contract request and maps approval', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(json(200, { status: 'approved', transaction_id: 'tx_1' }));
+    vi.stubGlobal('fetch', fetchMock);
+    const result = await new HttpPaymentGateway('http://pay', 'key', [0, 0]).charge(req);
+    expect(result).toEqual({ status: 'approved', transactionId: 'tx_1' });
+    const [url, init] = fetchMock.mock.calls[0];
+    expect(String(url)).toBe('http://pay/v1/charges');
+    expect(init.headers['X-Api-Key']).toBe('key');
+    expect(JSON.parse(init.body)).toEqual({ order_id: 'ord-1', amount: 1000, currency: 'RUB' });
+  });
+
+  it('maps decline', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(json(200, { status: 'declined', decline_reason: 'card_expired' })));
+    expect(await new HttpPaymentGateway('http://pay', 'k', [0, 0]).charge(req)).toEqual({ status: 'declined', reason: 'card_expired' });
+  });
+
+  it('retries network errors, 409 and 5xx with the same order_id', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('socket hang up'))
+      .mockResolvedValueOnce(json(409, { error: 'busy' }))
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx_2' }));
+    vi.stubGlobal('fetch', fetchMock);
+    const result = await new HttpPaymentGateway('http://pay', 'k', [0, 0]).charge(req);
+    expect(result.status).toBe('approved');
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('gives up with PaymentUnavailableError', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(json(503, { error: 'x' })));
+    await expect(new HttpPaymentGateway('http://pay', 'k', [0, 0]).charge(req)).rejects.toBeInstanceOf(PaymentUnavailableError);
+  });
+
+  it('does not retry 401', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(json(401, { error: 'key' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(new HttpPaymentGateway('http://pay', 'k', [0, 0]).charge(req)).rejects.toThrow('401');
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+});
