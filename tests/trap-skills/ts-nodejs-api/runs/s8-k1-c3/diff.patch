+
+describe('order payment', () => {
+  function payApp(charge: PaymentGateway['charge']) {
+    const store = new Store();
+    seedDemo(store);
+    const calls: string[] = [];
+    const app = createApp({
+      store,
+      payments: { charge },
+      notifier: { async orderPaid() { calls.push('mail'); } },
+      analytics: { async track(event, props) { calls.push(`${event}:${props.orderNumber}:${props.amountKopecks}`); } },
+    });
+    return { store, app, calls };
+  }
+
+  it('pays a new order', async () => {
+    const { app, store, calls } = payApp(async () => ({ status: 'approved', transactionId: 'tx-1' }));
+    const auth = await login(app, 'alice');
+    const res = await request(app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+    expect(res.body.status).toBe('paid');
+    expect(res.body.transactionId).toBe('tx-1');
+    expect(store.getOrder('ord-1001')?.status).toBe('paid');
+    expect(calls).toContain('mail');
+    expect(calls).toContain(`order_paid:1001:${res.body.totalKopecks}`);
+  });
+
+  it('returns 402 when the bank declines', async () => {
+    const { app, store, calls } = payApp(async () => ({ status: 'declined', reason: 'insufficient_funds' }));
+    const auth = await login(app, 'alice');
+    const res = await request(app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(402);
+    expect(res.body).toEqual({ error: { code: 'payment_declined', message: 'insufficient_funds' } });
+    expect(store.getOrder('ord-1001')?.status).toBe('new');
+    expect(calls).toEqual([]);
+  });
+
+  it('returns 404 for foreign or missing orders', async () => {
+    const { app } = payApp(async () => ({ status: 'approved', transactionId: 'tx' }));
+    const auth = await login(app, 'alice');
+    await request(app).post('/api/orders/ord-1004/pay').set('Authorization', auth).expect(404);
+    await request(app).post('/api/orders/nope/pay').set('Authorization', auth).expect(404);
+  });
+
+  it('returns 409 for an already paid order without charging', async () => {
+    let charges = 0;
+    const { app } = payApp(async () => {
+      charges += 1;
+      return { status: 'approved', transactionId: 'tx' };
+    });
+    const auth = await login(app, 'alice');
+    await request(app).post('/api/orders/ord-1003/pay').set('Authorization', auth).expect(409);
+    expect(charges).toBe(0);
+  });
+
+  it('still succeeds when the notifier fails', async () => {
+    const store = new Store();
+    seedDemo(store);
+    const app = createApp({
+      store,
+      payments: { async charge() { return { status: 'approved', transactionId: 'tx' }; } },
+      notifier: { async orderPaid() { throw new Error('down'); } },
+      analytics,
+    });
+    const auth = await login(app, 'alice');
+    await request(app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+  });
+});
