+    seedDemo(store);
+    const orderPaid = vi.fn(async () => {});
+    const track = vi.fn(async () => {});
+    const app = createApp({ store, payments: { charge }, notifier: { orderPaid }, analytics: { track } });
+    return { store, app, orderPaid, track };
+  }
+
+  it('pays a new order, stores transactionId, notifies and tracks', async () => {
+    const charge = vi.fn(async () => ({ status: 'approved' as const, transactionId: 'tx-1' }));
+    const c = payCtx(charge);
+    const auth = await login(c.app, 'alice');
+    const res = await request(c.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+    expect(res.body).toMatchObject({ id: 'ord-1001', status: 'paid', transactionId: 'tx-1' });
+    expect(charge).toHaveBeenCalledWith({ orderId: 'ord-1001', amountKopecks: 129000, currency: 'RUB' });
+    expect(c.store.getOrder('ord-1001')?.status).toBe('paid');
+    expect(c.orderPaid).toHaveBeenCalledOnce();
+    expect(c.track).toHaveBeenCalledWith('order_paid', { orderNumber: 1001, amountKopecks: 129000 });
+  });
+
+  it('returns 402 when the bank declines and keeps the order new', async () => {
+    const c = payCtx(async () => ({ status: 'declined', reason: 'insufficient_funds' }));
+    const auth = await login(c.app, 'alice');
+    const res = await request(c.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(402);
+    expect(res.body).toEqual({ error: { code: 'payment_declined', message: 'insufficient_funds' } });
+    expect(c.store.getOrder('ord-1001')?.status).toBe('new');
+    expect(c.orderPaid).not.toHaveBeenCalled();
+    expect(c.track).not.toHaveBeenCalled();
+  });
+
+  it('returns 404 for a foreign or missing order without charging', async () => {
+    const charge = vi.fn(async () => ({ status: 'approved' as const, transactionId: 'tx' }));
