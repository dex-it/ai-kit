index 0000000..fd83a10
--- /dev/null
+++ b/api/src/payments/http-gateway.ts
@@ -0,0 +1,74 @@
+import type { ChargeRequest, ChargeResult, PaymentGateway } from './gateway.js';
+
+export class PaymentUnavailableError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'PaymentUnavailableError';
+  }
+}
+
+export interface HttpPaymentGatewayOptions {
+  attempts?: number;
+  timeoutMs?: number;
+  retryDelayMs?: number;
+}
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+export class HttpPaymentGateway implements PaymentGateway {
+  private readonly attempts: number;
+  private readonly timeoutMs: number;
+  private readonly retryDelayMs: number;
+
+  constructor(
+    private readonly baseUrl: string,
+    private readonly apiKey: string,
+    options: HttpPaymentGatewayOptions = {},
+  ) {
+    this.attempts = options.attempts ?? 3;
+    this.timeoutMs = options.timeoutMs ?? 10_000;
+    this.retryDelayMs = options.retryDelayMs ?? 300;
+  }
+
+  // Шлюз идемпотентен по order_id: после сбоя или таймаута повторяем тот же запрос,
+  // деньги повторно не спишутся.
+  async charge(req: ChargeRequest): Promise<ChargeResult> {
+    let lastError: unknown;
+    for (let attempt = 1; attempt <= this.attempts; attempt++) {
+      if (attempt > 1) await sleep(this.retryDelayMs * 2 ** (attempt - 2));
+      try {
+        const result = await this.send(req);
+        if (result) return result;
+        lastError = new Error('payment gateway is temporarily unavailable');
+      } catch (err) {
+        if (err instanceof PaymentUnavailableError) throw err;
+        lastError = err;
+      }
+    }
+    throw new PaymentUnavailableError('payment result is unknown', { cause: lastError });
+  }
+
+  // undefined - временный сбой, можно повторять.
+  private async send(req: ChargeRequest): Promise<ChargeResult | undefined> {
+    const res = await fetch(new URL('/v1/charges', this.baseUrl), {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', 'X-Api-Key': this.apiKey },
+      body: JSON.stringify({ order_id: req.orderId, amount: req.amountKopecks, currency: req.currency }),
+      signal: AbortSignal.timeout(this.timeoutMs),
+    });
+    if (res.status === 409 || res.status >= 500) return undefined;
+    if (!res.ok) throw new PaymentUnavailableError(`payment gateway responded with ${res.status}`);
+    const body = (await res.json()) as {
+      status?: string;
+      transaction_id?: string;
+      decline_reason?: string;
+    };
+    if (body.status === 'approved' && body.transaction_id) {
+      return { status: 'approved', transactionId: body.transaction_id };
+    }
+    if (body.status === 'declined') {
+      return { status: 'declined', reason: body.decline_reason ?? 'unknown' };
+    }
+    throw new PaymentUnavailableError('payment gateway returned an unexpected response');
+  }
+}
