+  const payOrder = async (req: express.Request, res: express.Response): Promise<void> => {
+    const user = currentUser(req);
+    const order = findOwnOrder(store, user, req.params.id);
+    if (order.status !== OrderStatus.New) {
+      throw new HttpError(409, 'order_not_payable', `Order ${order.number} is ${order.status}`);
+    }
+    let result;
+    try {
+      result = await deps.payments.charge({
+        orderId: order.id,
+        amountKopecks: order.totalKopecks,
+        currency: 'RUB',
+      });
+    } catch (err) {
+      if (err instanceof PaymentUnavailableError) {
+        throw new HttpError(502, 'payment_unavailable', 'Payment gateway is unavailable, try again later');
+      }
+      throw err;
+    }
+    if (result.status === 'declined') {
+      throw new HttpError(402, 'payment_declined', result.reason);
+    }
+    // Заказ могли изменить, пока ждали шлюз (параллельная отмена или оплата).
+    const current = findOwnOrder(store, user, order.id);
+    if (current.status !== OrderStatus.New) {
+      throw new HttpError(409, 'order_not_payable', `Order ${current.number} is ${current.status}`);
+    }
+    const paid = store.saveOrder({ ...current, status: OrderStatus.Paid, transactionId: result.transactionId });
+    // Деньги уже списаны: сбои уведомления и аналитики не должны ломать ответ.
+    await Promise.all([
+      deps.notifier.orderPaid(paid),
+      deps.analytics.track('order_paid', { orderNumber: paid.number, amountKopecks: paid.totalKopecks }),
+    ].map((p) => p.catch((err) => logger.error(`post-payment hook failed for order ${paid.number}`, err))));
+    res.json(paid);
+  };
