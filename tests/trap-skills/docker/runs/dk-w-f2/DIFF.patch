+FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
+WORKDIR /src
+
+# Сначала только файлы для restore: слой с пакетами не пересобирается при правке кода.
+COPY global.json Directory.Build.props Directory.Packages.props ./
+COPY src/Depot.Api/Depot.Api.csproj src/Depot.Api/
+COPY src/Depot.Contracts/Depot.Contracts.csproj src/Depot.Contracts/
+RUN dotnet restore src/Depot.Api/Depot.Api.csproj
+
+COPY src/ src/
+RUN dotnet publish src/Depot.Api/Depot.Api.csproj -c Release --no-restore -o /app /p:UseAppHost=false
+
+# Chiseled: без shell и пакетного менеджера, по умолчанию не root (пользователь app), слушает 8080.
+FROM mcr.microsoft.com/dotnet/aspnet:8.0-jammy-chiseled AS final
+WORKDIR /app
+COPY --from=build /app .
+USER $APP_UID
+EXPOSE 8080
+# Exec-форма: worker запускается тем же образом с аргументом --worker (args в манифесте).
+ENTRYPOINT ["dotnet", "Depot.Api.dll"]
