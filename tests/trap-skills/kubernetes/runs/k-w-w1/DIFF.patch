--- /dev/null
+++ b/deploy/k8s/worker.yaml
@@ -0,0 +1,53 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-worker
+  namespace: depot
+  labels:
+    app: depot-worker
+spec:
+  # Ровно один экземпляр: два обработают очередь дважды.
+  replicas: 1
+  # Recreate: старый под останавливается до старта нового, двух экземпляров одновременно не будет.
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app: depot-worker
+  template:
+    metadata:
+      labels:
+        app: depot-worker
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: worker
+          image: registry.example.com/depot/api:1.4.0
+          args: ["--worker"]
+          envFrom:
+            - secretRef:
+                name: depot-config
+          resources:
+            requests:
+              cpu: 100m
+              memory: 384Mi
+            limits:
+              cpu: "1"
+              memory: 768Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
diff --git a/deploy/secret.example.yaml b/deploy/secret.example.yaml
new file mode 100644
