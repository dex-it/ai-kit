+++ b/deploy/secret.example.yaml
@@ -0,0 +1,14 @@
+# Шаблон, НЕ применяется вместе с deploy/k8s/. Реальные значения в репозиторий не коммитить.
+# Создать вручную (значения stage - в docs/stage-values.md):
+#   kubectl -n depot create secret generic depot-config \
+#     --from-literal=ConnectionStrings__Default='...' \
+#     --from-literal=Auth__ApiKey='...'
+apiVersion: v1
+kind: Secret
+metadata:
+  name: depot-config
+  namespace: depot
+type: Opaque
+stringData:
+  ConnectionStrings__Default: "<заполнить>"
+  Auth__ApiKey: "<заполнить>"
