diff --git a/deploy/k8s/22-api-pdb.yaml b/deploy/k8s/22-api-pdb.yaml
new file mode 100644
index 0000000..35c75b2
--- /dev/null
+++ b/deploy/k8s/22-api-pdb.yaml
@@ -0,0 +1,11 @@
+# Еженедельный drain нод не должен оставлять меньше 2 из 3 реплик.
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  minAvailable: 2
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-api
diff --git a/deploy/k8s/23-api-ingress.yaml b/deploy/k8s/23-api-ingress.yaml
new file mode 100644
index 0000000..a228bdd
--- /dev/null
+++ b/deploy/k8s/23-api-ingress.yaml
@@ -0,0 +1,22 @@
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  ingressClassName: nginx
+  tls:
+    - hosts:
+        - depot.example.com
+      secretName: depot-tls
+  rules:
+    - host: depot.example.com
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: depot-api
+                port:
+                  name: http
diff --git a/deploy/k8s/30-worker-deployment.yaml b/deploy/k8s/30-worker-deployment.yaml
new file mode 100644
index 0000000..5752c83
--- /dev/null
+++ b/deploy/k8s/30-worker-deployment.yaml
@@ -0,0 +1,65 @@
+# Ровно один экземпляр: два обработают очередь дважды. Recreate - чтобы при выкате
+# старый и новый поды никогда не работали одновременно.
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-worker
+  namespace: depot
+  labels:
+    app.kubernetes.io/name: depot-worker
+    app.kubernetes.io/part-of: depot
+spec:
+  replicas: 1
+  revisionHistoryLimit: 5
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-worker
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: depot-worker
+        app.kubernetes.io/part-of: depot
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: worker
+          image: registry.example.com/depot/api:1.4.0
+          command: ["dotnet", "Depot.Api.dll", "--worker"]
+          env:
+            - name: ASPNETCORE_URLS
+              value: http://+:8080
+            - name: ConnectionStrings__Default
+              valueFrom:
+                secretKeyRef:
+                  name: depot-env
+                  key: ConnectionStrings__Default
+            - name: Auth__ApiKey
+              valueFrom:
+                secretKeyRef:
+                  name: depot-env
+                  key: Auth__ApiKey
+          resources:
+            requests:
+              cpu: 50m
+              memory: 384Mi
+            limits:
+              memory: 512Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
