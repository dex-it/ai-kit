diff --git a/deploy/k8s/deployment.yaml b/deploy/k8s/deployment.yaml
index 6250202..1ab065f 100644
--- a/deploy/k8s/deployment.yaml
+++ b/deploy/k8s/deployment.yaml
@@ -5,6 +5,13 @@ metadata:
   namespace: depot
 spec:
   replicas: 3
+  # Выкат без простоя: сначала поднимаем новый под, старый убираем только после его готовности.
+  strategy:
+    type: RollingUpdate
+    rollingUpdate:
+      maxUnavailable: 0
+      maxSurge: 1
+  minReadySeconds: 10
   selector:
     matchLabels:
       app.kubernetes.io/name: depot-api
@@ -15,6 +22,20 @@ spec:
     spec:
       imagePullSecrets:
         - name: regcred
+      terminationGracePeriodSeconds: 45
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      # Реплики на разных нодах: drain одной ноды не уносит все поды.
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: ScheduleAnyway
+          labelSelector:
+            matchLabels:
+              app.kubernetes.io/name: depot-api
       containers:
         - name: api
           image: registry.example.com/depot/api:1.4.0
@@ -23,12 +44,35 @@ spec:
           envFrom:
             - secretRef:
                 name: depot-secrets
-          securityContext: {}
+          resources:
+            requests: { cpu: 100m, memory: 384Mi }
+            limits: { cpu: 500m, memory: 512Mi }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: ["ALL"] }
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+          lifecycle:
+            preStop:
+              exec:
+                command: ["sleep", "10"]
+          # Холодный старт (миграции) 20-35 с p95: даём до 150 с, пока liveness/readiness не включены.
+          startupProbe:
+            httpGet: { path: /health, port: 8080 }
+            periodSeconds: 5
+            failureThreshold: 30
           livenessProbe:
             httpGet: { path: /health, port: 8080 }
-            initialDelaySeconds: 0
-            periodSeconds: 1
-            failureThreshold: 1
+            periodSeconds: 10
+            timeoutSeconds: 3
+            failureThreshold: 6
           readinessProbe:
             httpGet: { path: /health, port: 8080 }
             periodSeconds: 5
+            timeoutSeconds: 3
+            failureThreshold: 2
+      volumes:
+        - name: tmp
+          emptyDir: {}
diff --git a/deploy/k8s/pdb.yaml b/deploy/k8s/pdb.yaml
new file mode 100644
index 0000000..c481bc4
--- /dev/null
+++ b/deploy/k8s/pdb.yaml
@@ -0,0 +1,11 @@
+# Weekly drain нод не должен оставить меньше 2 из 3 реплик API.
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  minAvailable: 2
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-api
