diff --git a/Jenkinsfile b/Jenkinsfile
new file mode 100644
index 0000000..83593d4
--- /dev/null
+++ b/Jenkinsfile
@@ -0,0 +1,152 @@
+// CI/CD сервиса Depot. Multibranch-job на GitHub; PR из форков тоже собираются, но без push и деплоя.
+@Library('depot-pipeline-lib@v1.4.0') _
+
+pipeline {
+    agent none
+
+    options {
+        disableConcurrentBuilds()
+        buildDiscarder(logRotator(numToKeepStr: '30'))
+    }
+
+    environment {
+        IMAGE = 'registry.example.com/depot/api'
+    }
+
+    stages {
+        stage('Build') {
+            agent { label 'dotnet-linux' }
+            steps {
+                cleanWs()
+                checkout scm
+                sh 'dotnet build Depot.sln -c Release'
+            }
+        }
+
+        stage('Test') {
+            failFast true
+            parallel {
+                stage('Unit') {
+                    agent { label 'dotnet-linux' }
+                    steps {
+                        cleanWs()
+                        checkout scm
+                        sh 'dotnet test tests/Depot.Api.Tests --filter "Category=Contracts" --logger "trx;LogFileName=unit.trx" --results-directory TestResults'
+                    }
+                    post {
+                        always {
+                            mstest testResultsFile: 'TestResults/*.trx', keepLongStdio: true
+                        }
+                    }
+                }
+
+                stage('Integration') {
+                    agent { label 'dotnet-linux' }
+                    steps {
+                        cleanWs()
+                        checkout scm
+                        // Postgres поднимает Testcontainers; нужен Docker на агенте.
+                        sh 'dotnet test tests/Depot.Api.Tests --filter "Category=Integration" --logger "trx;LogFileName=integration.trx" --results-directory TestResults'
+                    }
+                    post {
+                        always {
+                            mstest testResultsFile: 'TestResults/*.trx', keepLongStdio: true
+                        }
+                    }
+                }
+            }
+        }
+
+        stage('Image') {
+            agent { label 'dotnet-linux' }
+            stages {
+                stage('Checkout') {
+                    steps {
+                        cleanWs()
+                        checkout scm
+                        // Теги нужны для версии образа; без явного fetch Multibranch может их не подтянуть.
+                        sh 'git fetch --tags --force'
+                        script {
+                            // Наибольший семвер-тег по sort -V; пре-релизы (-rc и т.п.) не учитываются.
+                            def latest = sh(
+                                returnStdout: true,
+                                script: '''git tag --list | grep -E '^v?[0-9]+\\.[0-9]+\\.[0-9]+$' | sort -V | tail -n1'''
+                            ).trim()
+                            if (!latest) {
+                                error 'Не найден семвер-тег в репозитории'
+                            }
+                            env.IMAGE_TAG = "${latest}-${env.BUILD_NUMBER}"
+                        }
+                    }
+                }
+
+                stage('Build image') {
+                    steps {
+                        sh 'docker build -t "$IMAGE:$IMAGE_TAG" .'
+                    }
+                }
+
+                stage('Push') {
+                    when { branch 'main' }
+                    steps {
+                        withCredentials([usernamePassword(credentialsId: 'registry-creds', usernameVariable: 'REGISTRY_USER', passwordVariable: 'REGISTRY_PASSWORD')]) {
+                            sh 'echo "$REGISTRY_PASSWORD" | docker login registry.example.com -u "$REGISTRY_USER" --password-stdin'
+                            sh 'docker push "$IMAGE:$IMAGE_TAG"'
+                        }
+                    }
+                    post {
+                        always {
+                            sh 'docker logout registry.example.com || true'
+                        }
+                    }
+                }
+            }
+        }
+
+        stage('Deploy stage') {
+            when {
+                beforeAgent true
+                branch 'main'
+            }
+            agent { label 'dotnet-linux' }
+            steps {
+                cleanWs()
+                checkout scm
+                withCredentials([string(credentialsId: 'deploy-token', variable: 'DEPLOY_TOKEN')]) {
+                    sh './deploy.sh --token "$DEPLOY_TOKEN" --env stage'
+                }
+            }
+        }
+
+        // Без агента: ожидание лида может длиться до суток и дольше, executor не занимаем.
+        stage('Confirm prod') {
+            when { branch 'main' }
+            steps {
+                timeout(time: 7, unit: 'DAYS') {
+                    input message: "Деплоить ${env.IMAGE_TAG} на prod?"
+                }
+            }
+        }
+
+        stage('Deploy prod') {
+            when {
+                beforeAgent true
+                branch 'main'
+            }
+            agent { label 'dotnet-linux' }
+            steps {
+                cleanWs()
+                checkout scm
+                withCredentials([string(credentialsId: 'deploy-token', variable: 'DEPLOY_TOKEN')]) {
+                    sh './deploy.sh --token "$DEPLOY_TOKEN" --env prod'
+                }
+            }
+        }
+    }
+
+    post {
+        always {
+            notifySlack(currentBuild.currentResult)
+        }
+    }
+}
